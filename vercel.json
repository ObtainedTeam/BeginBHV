{
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cursusboek",
      "destination": "/cursussen",
      "permanent": true
    },
    {
      "source": "/cursussen/bhv-standaard",
      "destination": "/cursussen/bhv-basis",
      "permanent": true
    },
    {
      "source": "/cursussen/bhv-ploegleider",
      "destination": "/cursussen/ontruimingsoefening",
      "permanent": true
    },
    {
      "source": "/cursussen/bhv-bedrijfsleider",
      "destination": "/incompany",
      "permanent": true
    },
    {
      "source": "/locaties/amsterdam",
      "destination": "/locaties",
      "permanent": true
    },
    {
      "source": "/locaties/lelystad",
      "destination": "/locaties",
      "permanent": true
    },
    {
      "source": "/locaties/utrecht",
      "destination": "/locaties",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "beginbhv.nl"
        }
      ],
      "destination": "https://beginbhv.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.beginbhv.nl"
        }
      ],
      "destination": "https://beginbhv.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.beginbhv.com"
        }
      ],
      "destination": "https://beginbhv.com/$1",
      "permanent": true
    }
  ]
}