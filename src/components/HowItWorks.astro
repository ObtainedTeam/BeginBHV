---
// "Zo werkt het in drie stappen" (KAN-46). Data in src/data/home.js.
import { steps } from '../data/home.js';
---
<section class="how" aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title">Zo werkt het, in drie stappen</h2>
    <p class="how-sub">Van aanvraag tot certificaat zonder gedoe. Jij regelt de deelnemers, wij de rest.</p>
    <ol class="how-steps">
      {steps.map((s, i) => (
        <li class="how-step reveal" style={`transition-delay:${i * 120}ms`}>
          <span class="how-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <a class="btn btn-primary how-btn" href="/contact">Vraag een datum aan</a>
  </div>
</section>

<style>
  .how { background: var(--c-light); padding: 72px 0 80px; text-align: center; }
  .how h2 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h2); line-height: 1.2; margin: 0; }
  .how-sub { max-width: 560px; margin: 12px auto 0; font-size: var(--t-lg); font-weight: 200; line-height: 1.5; }
  .how-steps { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; counter-reset: step; }
  .how-step { position: relative; background: var(--c-white); border-radius: var(--r-lg); box-shadow: var(--sh-card); padding: 44px 28px 32px; text-align: left; }
  .how-step::after { content: ''; position: absolute; right: -22px; top: 50%; width: 16px; height: 16px; border-top: 3px solid var(--c-red); border-right: 3px solid var(--c-red); transform: translateY(-50%) rotate(45deg); }
  .how-step:last-child::after { display: none; }
  .how-n { position: absolute; top: -22px; left: 28px; width: 46px; height: 46px; border-radius: 50%; background: var(--c-red); color: #fff; font-family: var(--f-head); font-weight: 900; font-size: 22px; display: grid; place-items: center; box-shadow: var(--sh-btn); }
  .how-step h3 { font-family: var(--f-head); font-weight: 800; font-size: var(--t-h6); margin: 0 0 8px; }
  .how-step p { margin: 0; line-height: 1.6; font-weight: 200; }
  .how-btn { margin-top: 40px; }
  @media (max-width: 900px) {
    .how { padding: 56px 0 64px; }
    .how-steps { grid-template-columns: 1fr; gap: 40px; }
    .how-step::after { right: auto; left: 50%; top: auto; bottom: -26px; transform: translateX(-50%) rotate(135deg); }
  }
</style>
