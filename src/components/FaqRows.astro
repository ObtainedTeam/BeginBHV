---
// Figma Curs6: FAQ in rijen, met tekstkolom links
import Faq from './Faq.astro';
import { faq } from '../data/content.js';
const { intro } = Astro.props;
const text = intro ?? [
  'Staat uw vraag er niet tussen? Bel ons of stuur een bericht via de contactpagina. We denken graag met u mee over de juiste cursus, het aantal BHV’ers dat uw organisatie nodig heeft en de mogelijkheden voor training op uw eigen locatie.',
  'Een geldig BHV certificaat is één jaar geldig; we herinneren u op tijd aan de herhaling.',
];
---
<section class="fr" aria-labelledby="fr-title">
  <div class="container fr-inner">
    <h2 id="fr-title">Veel gestelde vragen</h2>
    <div class="fr-grid">
      <div class="fr-text">
        <h3>Is uw vraag nóg niet beantwoord?</h3>
        {text.map((p) => <p>{p}</p>)}
      </div>
      <div class="fr-list"><Faq items={faq} variant="rows" /><a class="fr-all" href="/veelgestelde-vragen">Alle veelgestelde vragen ›</a></div>
    </div>
  </div>
</section>
<style>
  .fr { background: var(--c-white); }
  .fr-inner { padding-top: 12px; padding-bottom: 60px; }
  h2 { font-family: var(--f-head); font-weight: 700; font-size: var(--t-h3); text-align: center; line-height: 1.3; }
  .fr-grid { display: grid; grid-template-columns: 413px 715px; justify-content: space-between; gap: 40px; padding-left: 70px; padding-right: 56px; margin-top: 32px; }
  h3 { font-family: var(--f-head); font-weight: 600; font-size: var(--t-h3); line-height: 1.25; width: 364px; margin-top: 12px; }
  .fr-text p { font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); line-height: 1.25; margin-top: 20px; }
  .fr-text p + p { margin-top: 0; }
  .fr-all { display: inline-block; margin-top: 14px; font-family: var(--f-head); font-weight: 700; font-size: var(--t-md); color: var(--c-red-dark); }
  @media (max-width: 1100px) { .fr-grid { grid-template-columns: 1fr; padding-inline: 0; } h3 { width: auto; } }
  @media (max-width: 700px) { h2, h3 { font-size: 26px; } }
</style>
