---
import Base from '../layouts/Base.astro';
const { title, description, sections } = Astro.props;
---
<Base title={title} description={description}>
  <section class="lg">
    <div class="container lg-inner">
      <h1>{title}</h1>
      <p class="lg-note">Concepttekst. Laat deze tekst controleren en aanvullen voordat de site live gaat.</p>
      {sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((t) => <p>{t}</p>)}
        </section>
      ))}
    </div>
  </section>
</Base>
<style>
  .lg-inner { padding-top: 110px; padding-bottom: 100px; max-width: 820px; }
  h1 { font-family: var(--f-head); font-weight: 800; font-size: var(--t-display); line-height: 1.2; margin-bottom: 12px; }
  .lg-note { font-family: var(--f-head); font-weight: 300; font-size: var(--t-sm); color: var(--c-red-dark); margin-bottom: 30px; }
  h2 { font-family: var(--f-head); font-weight: 700; font-size: var(--t-lg); margin: 28px 0 8px; }
  p { font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); line-height: 1.4; margin-bottom: 10px; }
</style>
