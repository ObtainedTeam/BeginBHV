---
// Figma Curs4: "Boek nu een BHV cursus en betaal achteraf"
const { title = 'Boek nu een BHV cursus en betaal achteraf' } = Astro.props;
---
<section class="cta">
  <div class="container cta-inner">
    <div class="cta-card reveal">
      <h2>{title}</h2>
      <p>Het is mogelijk om de BHV cursus via iDeal, vooraf- of achteraf te betalen. De getoonde tarieven zijn alle kosten.</p>
      <div class="cta-btns">
        <a class="btn btn-plan" href="/contact">Plan met Dennis</a>
        <a class="btn btn-outline" href="/contact">Vraag offerte aan</a>
      </div>
      <div class="cta-photo">
        <img src="/images/dennis-cta.webp" alt="" width="217" height="217" loading="lazy" />
      </div>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--c-coral); }
  .cta-inner { min-height: 376.7px; padding-top: 75.3px; padding-bottom: 25px; padding-left: max(var(--gutter), 183px); }
  @media (min-width: 1420px) { .cta-inner { padding-left: 183px; } }
  .cta-card {
    position: relative; width: 1020.7px; max-width: 100%; height: 244px;
    background: var(--c-light); border-radius: 45.3px; box-shadow: var(--sh-card);
    padding: 30px 0 0 37px;
  }
  h2 { font-family: var(--f-head); font-weight: 700; font-size: var(--t-h2); color: var(--c-red); line-height: 1.25; width: 604px; }
  p { font-family: var(--f-body); font-weight: 100; font-size: var(--t-lg); width: 573px; margin-top: 10px; line-height: 1.2; }
  .cta-btns { position: absolute; left: 674.7px; top: 64px; display: flex; flex-direction: column; gap: 17.7px; }
  .cta-btns .btn-outline { width: 193.7px; }
  .cta-photo {
    position: absolute; left: 901px; top: 58px; width: 216.7px; height: 216.7px; border-radius: 50%; overflow: hidden;
    box-shadow: 4px 6px 0 var(--c-red), 0.7px 1.3px 1.3px rgba(0,0,0,.25);
  }
  .cta-photo img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 1100px) {
    .cta-inner { padding-left: var(--gutter); }
    .cta-card { height: auto; padding: 30px 24px 30px; border-radius: 28px; }
    h2, p { width: auto; }
    .cta-btns { position: static; flex-direction: row; flex-wrap: wrap; margin-top: 20px; }
    .cta-photo { position: static; margin-top: 20px; width: 160px; height: 160px; }
  }
  @media (max-width: 700px) { h2 { font-size: 26px; } }
</style>
