---
import { usps } from '../data/site.js';
const icons = {
  map: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14M15 6v14"/></svg>',
  certificate: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="2.5" width="16" height="15" rx="1.5"/><path d="M8 7h8M8 10.5h8"/><path d="M9 17.5V22l3-1.5 3 1.5v-4.5"/></svg>',
  cap: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 9l10-4 10 4-10 4z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/><path d="M22 9v6"/></svg>',
  advice: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M12 16v4M8 20h8"/></svg>',
};
---
<section class="usp" aria-label="Waarom BeginBHV">
  <!-- langzame carousel: inhoud twee keer, schuift naar rechts en komt links weer binnen -->
  <div class="track" aria-hidden="false">
    {[0, 1].map((k) => (
      <div class="group" aria-hidden={k === 1 ? 'true' : undefined}>
        {usps.map((u) => (
          <div class="item">
            <span class="icon" set:html={icons[u.icon]} />
            <span>{u.label}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
<style>
  .usp { background: var(--c-light); overflow: hidden; min-height: 114px; display: flex; align-items: center; box-shadow: inset 0 1px 0 rgba(0,0,0,.04); }
  .track { display: flex; width: max-content; animation: usp-slide 38s linear infinite; }
  .track:hover { animation-play-state: paused; }
  .group { display: flex; align-items: center; gap: 96px; padding-right: 96px; }
  .item { display: flex; align-items: center; gap: 8px; font-family: var(--f-head); font-weight: 300; font-size: var(--t-lg); white-space: nowrap; }
  .icon { width: 22px; height: 22px; color: var(--c-black); flex: none; }
  .icon :global(svg) { width: 100%; height: 100%; }
  /* naar rechts: begint op -50% (tweede kopie in beeld) en schuift naar 0 */
  @keyframes usp-slide { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
  @media (max-width: 700px) { .usp { min-height: 80px; } .item { font-size: 18px; } .group { gap: 56px; padding-right: 56px; } }
</style>
