---
// Contactkaart (Figma "Laten we kennis maken!" en "Contact").
// variant "wide" = kaart met opmerkingenveld rechts (home, sectie Dennis)
// variant "narrow" = smalle kaart (home, naast FAQ)
const { variant = 'wide', title = 'Laten we kennis maken!', source = 'home' } = Astro.props;
const fields = [
  { name: 'company', label: 'Bedrijfsnaam', auto: 'organization', required: true },
  { name: 'email', label: 'E-mailadres', type: 'email', auto: 'email', required: true },
  { name: 'address', label: 'Bedrijfsadres', auto: 'street-address' },
  { name: 'postcode', label: 'Postcode', auto: 'postal-code' },
  { name: 'city', label: 'Plaats', auto: 'address-level2' },
];
---
{variant === 'narrow' ? (
<form class="ccard narrow" method="post" action="/api/aanvraag" data-form>
  <div class="n-head">
    <h2>{title}</h2>
    <p class="n-sub">Laat je gegevens achter, we reageren binnen één werkdag.</p>
  </div>
  <input type="hidden" name="source" value={source} />
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
  <div class="n-grid">
    <label><span>Bedrijfsnaam *</span><input type="text" name="company" autocomplete="organization" required /></label>
    <label><span>Je naam *</span><input type="text" name="name" autocomplete="name" required /></label>
    <label><span>E-mailadres *</span><input type="email" name="email" autocomplete="email" required /></label>
    <label><span>Telefoon</span><input type="tel" name="phone" autocomplete="tel" /></label>
    <label class="full"><span>Waar kunnen we je mee helpen?</span><textarea name="message" rows="3" placeholder="Bijvoorbeeld: 6 collega's Basis BHV, liefst in november."></textarea></label>
  </div>
  <button class="btn btn-send n-btn" type="submit">Verstuur aanvraag</button>
  <p class="n-note">Geen verplichtingen. Je gegevens gebruiken we alleen om contact op te nemen.</p>
  <p class="status" role="status" aria-live="polite"></p>
</form>
) : (
<form class={`ccard ${variant}`} method="post" action="/api/aanvraag" data-form>
  <h2>{title}</h2>
  <input type="hidden" name="source" value={source} />
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
  <div class="cols">
    <fieldset class="left">
      <legend>Locatie</legend>
      {fields.map((f) => (
        <label>
          <span>{f.label}</span>
          <input type={f.type ?? 'text'} name={f.name} placeholder={f.label} autocomplete={f.auto} required={f.required} />
        </label>
      ))}
    </fieldset>
    {variant === 'wide' && (
      <div class="right">
        <label>
          <span>Opmerking(en)</span>
          <textarea name="message" placeholder="Opmerking(en)" rows="5"></textarea>
        </label>
        <button class="btn btn-send" type="submit">Verstuur</button>
      </div>
    )}
  </div>
  {variant === 'narrow' && <button class="btn btn-send big" type="submit">Verstuur</button>}
  <p class="status" role="status" aria-live="polite"></p>
</form>
)}
<style>
  .ccard { background: var(--c-light); border-radius: var(--r-md); box-shadow: var(--sh-card-strong); }
  .hp { position: absolute; left: -9999px; }
  h2 { font-family: var(--f-head); font-weight: 900; text-align: center; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { font-family: var(--f-head); font-weight: 700; padding: 0; }
  label { display: block; }
  label span { display: block; font-family: var(--f-body); font-weight: 100; color: var(--c-black); }
  input, textarea {
    width: 100%; border: 0; background: var(--c-white); box-shadow: var(--sh-input);
    font-family: var(--f-body); font-weight: 100; color: var(--c-black);
  }
  input::placeholder, textarea::placeholder { color: rgba(0,0,0,.53); }
  textarea { resize: vertical; }
  .status { font-family: var(--f-head); font-weight: 300; font-size: 14px; min-height: 1em; margin-top: 8px; }
  .status.ok { color: var(--c-green-dark); } .status.err { color: var(--c-red-dark); }

  /* wide: 466 x 299 */
  .wide { width: 100%; max-width: 466.3px; padding: 22px 16px 16px 19.3px; }
  .wide h2 { font-size: var(--t-h3); margin-bottom: 25px; }
  @media (max-width: 560px) { .wide h2 { font-size: 24px; } }
  .wide .cols { display: grid; grid-template-columns: 206px 192px; gap: 33px; }
  .wide legend { font-size: var(--t-lg); margin-bottom: 7px; }
  .wide label span { font-size: var(--t-xs); margin-bottom: 1px; }
  .wide label + label { margin-top: 5px; }
  .wide input { height: 21.3px; border-radius: 5px; padding: 0 10px; font-size: var(--t-xs); }
  .wide .right { display: flex; flex-direction: column; }
  .wide .right label { margin-top: 26px; }
  .wide textarea { height: 88px; border-radius: var(--r-md); padding: 6px 9px; font-size: var(--t-xs); }
  .wide .right .btn { align-self: center; margin-top: 19px; }
  @media (max-width: 520px) {
    .wide .cols { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .wide input { height: 42px; font-size: 16px; }
    .wide textarea { height: 110px; font-size: 16px; }
    .wide .right label { margin-top: 0; }
  }

  /* narrow: herontworpen contactblok (home naast FAQ) */
  .narrow { width: 100%; max-width: 480px; padding: 28px 28px 24px; border-radius: 16px; text-align: left; }
  .narrow h2 { text-align: left; font-size: var(--t-h4); line-height: 1.15; }
  .n-sub { font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); margin: 6px 0 20px; color: #333; }
  .n-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 14px; }
  .n-grid .full { grid-column: 1 / -1; }
  .narrow label span { font-family: var(--f-head); font-weight: 500; font-size: var(--t-sm); margin-bottom: 5px; color: #222; }
  .narrow input, .narrow textarea { height: 44px; border-radius: 10px; padding: 0 12px; font-size: var(--t-md); font-weight: 300; border: 1px solid rgba(0,0,0,.08); box-shadow: 0 1px 2px rgba(0,0,0,.04); transition: box-shadow .15s ease, border-color .15s ease; }
  .narrow textarea { height: auto; padding: 10px 12px; min-height: 84px; }
  .narrow input:focus, .narrow textarea:focus { outline: 0; border-color: var(--c-red-dark); box-shadow: 0 0 0 3px rgba(188,0,0,.15); }
  .n-btn { width: 100%; height: 52px; margin-top: 18px; font-size: var(--t-lg); border-radius: 10px; justify-content: center; }
  .n-note { font-family: var(--f-body); font-weight: 200; font-size: var(--t-sm); color: #555; margin-top: 10px; }
  @media (max-width: 480px) { .n-grid { grid-template-columns: 1fr; } .narrow { padding: 22px 18px; } }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.status')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true; status.className = 'status'; status.textContent = 'Versturen…';
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        if (!res.ok) throw new Error();
        location.href = '/bedankt';
      } catch {
        status.className = 'status err'; status.textContent = 'Versturen is niet gelukt. Bel ons of mail naar info@beginbhv.nl.';
      } finally { btn.disabled = false; }
    });
  });
</script>
