---
// Meerstaps aanvraagfunnel. Vragen komen uit src/data/content.js (funnel).
// Blijft op dezelfde pagina, met voortgang, terug-knop en afronding.
import { funnel } from '../data/content.js';
import { site } from '../data/site.js';
const steps = funnel.steps;
---
<div class="funnel" data-funnel>
  <div class="f-head">
    <h2 class="f-title" data-title>{steps[0].title}</h2>
    <p class="f-progress-label"><span data-stepnum>1</span> van {steps.length}</p>
    <div class="f-progress" role="progressbar" aria-valuemin="1" aria-valuemax={steps.length} aria-valuenow="1" aria-label="Voortgang">
      <span data-bar style={`width:${100 / steps.length}%`}></span>
    </div>
  </div>

  <form method="post" action="/api/aanvraag" novalidate>
    <input type="hidden" name="source" value="funnel" />
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

    {steps.map((s, i) => (
      <fieldset class="f-step" data-step={i} hidden={i !== 0}>
        <legend class="sr-only">{s.title}</legend>
        {s.type === 'choice' && (
          <div class="f-options">
            {s.options.map((o) => (
              <label class="f-opt">
                <input type="radio" name={s.id} value={o.value} required />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        )}
        {s.type === 'form' && (
          <div class="f-fields">
            {s.fields.map((f) => (
              <label class={`f-field ${f.type === 'textarea' ? 'wide' : ''}`}>
                <span>{f.label}{f.required && ' *'}</span>
                {f.type === 'textarea'
                  ? <textarea name={f.name} rows="4" placeholder={f.label}></textarea>
                  : <input type={f.type} name={f.name} placeholder={f.label} autocomplete={f.autocomplete} required={f.required} />}
              </label>
            ))}
          </div>
        )}
      </fieldset>
    ))}

    <div class="f-done" data-done hidden>
      <h3>{funnel.done.title}</h3>
      <p>{funnel.done.text}</p>
      <a class="btn btn-plan" href={site.phoneHref}>Bel {site.phone}</a>
    </div>

    <p class="f-error" role="alert" data-error></p>

    <div class="f-nav" data-nav>
      <button type="button" class="f-back" data-back hidden>‹ Terug</button>
      <button type="button" class="btn btn-primary f-next" data-next>Volgende ›</button>
      <button type="submit" class="btn btn-primary f-submit" data-submit hidden>Verstuur aanvraag ›</button>
    </div>
    <p class="f-note">Of bel direct: <a href={site.phoneHref}>{site.phone}</a></p>
  </form>
</div>

<style>
  .funnel { background: var(--c-light); border-radius: var(--r-md); box-shadow: 1.3px 2.3px 1.3px rgba(0,0,0,.45); padding: 28px 32px 24px; }
  .hp { position: absolute; left: -9999px; }
  .f-title { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h5); line-height: 1.2; }
  .f-progress-label { font-family: var(--f-head); font-weight: 300; font-size: var(--t-sm); margin-top: 6px; }
  .f-progress { height: 7.7px; border-radius: 5px; background: #fff; overflow: hidden; margin-top: 6px; }
  .f-progress span { display: block; height: 100%; background: var(--c-red-dark); border-radius: 5px; transition: width .3s ease; }
  fieldset { border: 0; margin: 22px 0 0; padding: 0; min-width: 0; animation: slide .3s ease; }
  @keyframes slide { from { opacity: 0; transform: translateX(16px); } }
  @media (prefers-reduced-motion: reduce) { fieldset { animation: none; } }
  .f-options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .f-opt { position: relative; display: block; }
  .f-opt input { position: absolute; opacity: 0; inset: 0; }
  .f-opt span {
    display: flex; align-items: center; min-height: 49px; padding: 10px 18px; border-radius: var(--r-md);
    background: var(--c-red-dark); color: #fff; font-family: var(--f-body); font-weight: 900; font-size: var(--t-lg); line-height: 1.1;
    box-shadow: var(--sh-btn); cursor: pointer; transition: transform .15s, filter .15s;
  }
  .f-opt:hover span { filter: brightness(1.1); }
  .f-opt input:checked + span { background: var(--c-green); }
  .f-opt input:focus-visible + span { outline: 3px solid #000; outline-offset: 2px; }
  .f-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; }
  .f-field.wide { grid-column: 1 / -1; }
  .f-field span { display: block; font-family: var(--f-body); font-weight: 100; font-size: var(--t-md); margin-bottom: 2px; }
  .f-field input, .f-field textarea { width: 100%; border: 0; border-radius: 5px; background: #fff; box-shadow: var(--sh-input); padding: 0 9px; height: 28.3px; font-family: var(--f-body); font-weight: 100; font-size: var(--t-md); }
  .f-field textarea { height: auto; padding: 6px 9px; resize: vertical; }
  .f-field input:user-invalid { outline: 2px solid var(--c-red); }
  .f-nav { display: flex; align-items: center; justify-content: space-between; margin-top: 24px; gap: 12px; }
  .f-back { background: none; border: 0; font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); padding: 8px 0; }
  .f-next, .f-submit { margin-left: auto; }
  .f-error { font-family: var(--f-head); font-weight: 300; font-size: 14px; color: var(--c-red-dark); min-height: 1em; margin-top: 10px; }
  .f-note { font-family: var(--f-head); font-weight: 300; font-size: var(--t-sm); margin-top: 14px; text-align: center; }
  .f-note a { text-decoration: underline; }
  .f-done { text-align: center; padding: 24px 0 8px; }
  .f-done h3 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h5); }
  .f-done p { font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); margin: 10px 0 20px; }
  @media (max-width: 560px) { .f-options, .f-fields { grid-template-columns: 1fr; } .funnel { padding: 20px 16px; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-funnel]');
  if (root) {
    const form = root.querySelector('form')!;
    const steps = [...root.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const titles = steps.map((s) => s.querySelector('legend')!.textContent!);
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const num = root.querySelector<HTMLElement>('[data-stepnum]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const prog = root.querySelector<HTMLElement>('.f-progress')!;
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const err = root.querySelector<HTMLElement>('[data-error]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    const nav = root.querySelector<HTMLElement>('[data-nav]')!;
    let i = 0;

    // Vooraf gekozen cursus via ?cursus=slug
    const pre = new URLSearchParams(location.search).get('cursus');
    if (pre) { const r = form.querySelector<HTMLInputElement>(`input[name=course][value="${pre}"]`); if (r) r.checked = true; }

    const show = (n: number) => {
      i = n; err.textContent = '';
      steps.forEach((s, k) => (s.hidden = k !== i));
      title.textContent = titles[i]; num.textContent = String(i + 1);
      bar.style.width = `${((i + 1) / steps.length) * 100}%`; prog.setAttribute('aria-valuenow', String(i + 1));
      back.hidden = i === 0; next.hidden = i === steps.length - 1; submit.hidden = i !== steps.length - 1;
      steps[i].querySelector<HTMLElement>('input, textarea')?.focus({ preventScroll: true });
    };
    const valid = () => {
      const req = [...steps[i].querySelectorAll<HTMLInputElement>('input[required]')];
      const radios = req.filter((r) => r.type === 'radio');
      if (radios.length && !radios.some((r) => r.checked)) { err.textContent = 'Maak een keuze om verder te gaan.'; return false; }
      for (const f of req.filter((r) => r.type !== 'radio')) { if (!f.checkValidity()) { err.textContent = 'Vul de verplichte velden (*) correct in.'; f.focus(); return false; } }
      return true;
    };
    next.addEventListener('click', () => { if (valid()) show(i + 1); });
    back.addEventListener('click', () => show(i - 1));
    // Keuze maken = automatisch door naar de volgende stap.
    steps.forEach((s, k) => s.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => r.addEventListener('change', () => { if (k === i && k < steps.length - 1) setTimeout(() => show(k + 1), 180); })));
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); if (!valid()) return;
      submit.disabled = true; err.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        if (!res.ok) throw new Error();
        steps.forEach((s) => (s.hidden = true)); nav.hidden = true; done.hidden = false;
        title.textContent = 'Aanvraag verstuurd'; bar.style.width = '100%';
        (window as any).gtag?.('event', 'generate_lead', { form: 'funnel' });
      } catch { err.textContent = 'Versturen is niet gelukt. Probeer het opnieuw of bel ons.'; }
      finally { submit.disabled = false; }
    });
    show(pre ? 1 : 0);
  }
</script>
