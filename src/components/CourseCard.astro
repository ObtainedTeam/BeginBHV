---
// Cursuskaart (Figma Curs2): 377.7 x 571, radius 26.3
const { course, delay = 0 } = Astro.props;
---
<article class="cc reveal" style={`transition-delay:${delay}ms`}>
  <a class="cc-img" href={`/cursussen/${course.slug}`} tabindex="-1" aria-hidden="true">
    <img src={course.image} alt="" width="378" height="252" loading="lazy" />
  </a>
  <div class="cc-stripe"></div>
  <div class="cc-body">
    <h3><a href={`/cursussen/${course.slug}`}>{course.title}</a></h3>
    <p class="cc-sub">{course.blurb}</p>
    <ul class="checklist cc-list">
      {course.bullets.map((b) => <li>{b}</li>)}
    </ul>
    <a class="btn btn-primary cc-btn" href={`/cursussen/${course.slug}`}>Plan direct</a>
  </div>
</article>

<style>
  .cc {
    position: relative; width: 377.7px; height: 571px;
    background: var(--c-light); border-radius: var(--r-2xl);
    box-shadow: var(--sh-card); overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease, opacity .6s ease;
  }
  .cc:hover { transform: translateY(-4px); box-shadow: var(--sh-card-strong); }
  .cc-img { display: block; height: 252px; position: relative; }
  .cc-img img { width: 100%; height: 100%; object-fit: cover; }
  .cc-img::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,.45); }
  .cc-stripe { height: 23px; background: var(--c-red); }
  .cc-body { padding: 10px 20px 0 27px; position: relative; height: 296px; }
  h3 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h5); line-height: 1.65; }
  .cc-sub { font-family: var(--f-head); font-weight: 300; font-size: var(--t-sm); line-height: 1.2; margin: -4px 0 0 7px; width: 238px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .cc-list { margin: 12px 0 0 19px; }
  .cc-list li + li { margin-top: 27px; }
  .cc-btn { position: absolute; left: 27px; bottom: 13px; }
  @media (max-width: 420px) { .cc { width: 100%; height: auto; } .cc-body { height: auto; padding-bottom: 76px; } h3 { line-height: 1.25; margin-bottom: 8px; } }
</style>
