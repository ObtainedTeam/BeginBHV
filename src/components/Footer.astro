---
import { site } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container top">
    <div class="col">
      <h2>Hulp nodig?</h2>
      <address>
        {site.name}<br />
        {site.address.map((l) => (<>{l}<br /></>))}
        Bel <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>
    <div class="col">
      <h2>Wij zijn BeginBHV</h2>
      <ul>
        <li><a href="/over-ons">Over <strong>BeginBHV</strong></a></li>
        <li><a href="/klantenservice">Klantenservice</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/locaties">Locaties</a></li>
        <li><a href="/vacatures">Vacatures</a></li>
        <li><a href="/kennisbank">Kennisbank</a></li>
        <li><a href="/branches">BHV per branche</a></li>
        <li><a href="/veelgestelde-vragen">Veelgestelde vragen</a></li>
      </ul>
    </div>
    <div class="col news">
      <h2>Nieuws</h2>
      <p>
        BeginBHV traint het hele jaar door op locaties in heel Nederland en bij bedrijven op de werkvloer. Nieuwe cursusdata, wijzigingen in de Arbowet en praktische tips voor uw BHV-organisatie leest u binnenkort op onze blog.
      </p>
      <div class="logos" aria-label="Betaalmethoden en keurmerken">
        <img src="/images/logo-ideal.png" alt="iDEAL" width="33" height="33" loading="lazy" />
        <img src="/images/logo-creditcard.png" alt="Visa en Mastercard" width="100" height="20" loading="lazy" />
        <img src="/images/logo-ccv.png" alt="CCV REOB onderhoud" width="33" height="57" loading="lazy" />
        <img src="/images/logo-bvbn.png" alt="BVBN Branchevereniging Bedrijfshulpverlening Nederland" width="100" height="27" loading="lazy" />
      </div>
    </div>
  </div>
  <div class="bottom">
    <div class="container bottom-inner">
      <span>© {site.legalName} {year}</span>
      <nav aria-label="Juridisch">
        <a href="/algemene-voorwaarden">Algemene voorwaarden</a>
        <span aria-hidden="true">|</span>
        <a href="/privacy">Privacy &amp; cookies</a>
        <span aria-hidden="true">|</span>
        <a href="/sitemap-index.xml">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--c-red); color: var(--c-white); }
  .top {
    display: grid; grid-template-columns: 335px 385px 1fr;
    padding-top: 64.7px; padding-bottom: 30px;
    padding-left: max(var(--gutter), 92px);
  }
  @media (min-width: 1420px) { .top { padding-left: 92px; } }
  h2 { font-family: var(--f-head); font-weight: 800; font-size: var(--t-lg); margin: 0 0 14px; line-height: 1.4; }
  .news h2 { margin-top: 3px; }
  address { font-style: normal; font-family: var(--f-head); font-weight: 400; font-size: var(--t-md); line-height: 1.25; }
  ul { list-style: none; margin: 0; padding: 0; font-family: var(--f-head); font-weight: 400; font-size: var(--t-md); line-height: 1.25; }
  .footer a:hover { text-decoration: underline; }
  .news p { font-family: var(--f-body); font-weight: 200; font-size: var(--t-md); max-width: 500px; line-height: 1.2; }
  .logos { display: flex; align-items: center; gap: 15px; justify-content: flex-end; margin-top: 32px; padding-right: 11px; }
  .logos img { height: auto; }
  .bottom { background: var(--c-grey); color: var(--c-black); }
  .bottom-inner {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;
    min-height: 84.7px; padding-left: max(var(--gutter), 92px); padding-right: max(var(--gutter), 255px);
    font-family: var(--f-body); font-weight: 100; font-size: var(--t-md);
  }
  @media (min-width: 1420px) { .bottom-inner { padding-left: 92px; padding-right: 255px; } }
  .bottom nav { display: flex; gap: 6px; }
  @media (max-width: 1024px) {
    .top { grid-template-columns: 1fr 1fr; gap: 24px; }
    .news { grid-column: 1 / -1; }
    .logos { justify-content: flex-start; }
    .bottom-inner { padding-right: var(--gutter); }
  }
  @media (max-width: 600px) {
    .top { grid-template-columns: 1fr; padding-top: 40px; }
    .logos { flex-wrap: wrap; }
    .bottom-inner { flex-direction: column; align-items: flex-start; padding-block: 16px; }
  }
</style>
