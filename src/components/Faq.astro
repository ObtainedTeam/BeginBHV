---
// Accordion. variant "cards" = losse witte kaarten (home), "rows" = gestreepte rijen (cursussen).
const { items, variant = 'cards', openFirst = false } = Astro.props;
---
<div class={`faq faq-${variant}`}>
  {items.map((it, i) => (
    <details class="faq-item" open={openFirst && i === 1 ? true : undefined}>
      <summary>
        <span>{it.q}</span>
        <img src="/images/icon-chevron.png" alt="" width="35" height="35" />
      </summary>
      <div class="answer"><p>{it.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { display: flex; flex-direction: column; }
  .faq-item { background: var(--c-white); }
  summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    font-family: var(--f-head); font-weight: 700; font-size: var(--t-h3); line-height: 1.25;
  }
  summary::-webkit-details-marker { display: none; }
  summary img { flex: none; transition: transform .25s ease; }
  details[open] summary img { transform: rotate(180deg); }
  .answer { font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); line-height: 1.25; }

  /* home: losse kaarten */
  .faq-cards { gap: 35.3px; }
  .faq-cards .faq-item { border-radius: var(--r-md); box-shadow: var(--sh-card-strong); }
  .faq-cards summary { min-height: 70.7px; padding: 10px 21px 10px 21px; }
  .faq-cards .answer { margin: 0 21px 24px; padding-top: 18px; border-top: 0.5px solid #000; }

  /* cursussen: afwisselende rijen */
  .faq-rows { gap: 0; }
  .faq-rows .faq-item { background: var(--c-light); }
  .faq-rows .faq-item:nth-child(odd) { background: var(--c-pink); }
  .faq-rows summary { min-height: 54.3px; padding: 8px 10px 8px 15.7px; font-weight: 400; font-size: var(--t-h6); }
  .faq-rows summary img { width: 35px; height: 35px; }
  .faq-rows .answer { padding: 0 15.7px 18px; }

  .answer { animation: fade .3s ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) { .answer { animation: none; } summary img { transition: none; } }
  @media (max-width: 700px) {
    summary { font-size: 20px; }
    .faq-rows summary { font-size: 18px; }
    .faq-cards { gap: 16px; }
  }
</style>
