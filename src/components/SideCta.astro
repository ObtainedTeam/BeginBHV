---
// Zijkolom met cursus-CTA en contact (kennisbank, branche, blog).
import { site } from '../data/site.js';
import { courses, priceNote } from '../data/courses.js';
const { courseSlug = 'bhv-basis', title = 'Direct een BHV-cursus plannen?' } = Astro.props;
const c = courses.find((x) => x.slug === courseSlug) ?? courses[0];
---
<aside class="side">
  <div class="side-card reveal">
    <h3>{title}</h3>
    <p class="side-course">{c.title}</p>
    <p class="side-price">€ {c.price} <span>{c.priceNote ?? priceNote}</span></p>
    <ul class="checklist">{c.bullets.map((b) => <li>{b}</li>)}</ul>
    <a class="btn btn-plan" href={`/contact?cursus=${c.slug}`}>Plan met Dennis</a>
    <a class="side-link" href={`/cursussen/${c.slug}`}>Bekijk de cursus ›</a>
  </div>
  <div class="side-contact">
    <p class="side-h">Liever even bellen?</p>
    <a href={site.phoneHref}>{site.phone}</a><br />
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </div>
  <div class="side-rating">
    <span class="score">{site.googleRating}</span>
    <span>Gemiddelde waardering op Google</span>
  </div>
</aside>

<style>
  .side { position: sticky; top: 24px; }
  .side-card { background: var(--c-light); border-radius: var(--r-lg); box-shadow: var(--sh-card); padding: 22px 22px 24px; }
  .side-card h3 { font-family: var(--f-head); font-weight: 700; font-size: var(--t-lg); line-height: 1.25; }
  .side-course { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h6); margin-top: 14px; line-height: 1.2; overflow-wrap: anywhere; }
  .side-price { font-family: var(--f-head); font-weight: 800; font-size: var(--t-h3); line-height: 1.2; }
  .side-price span { font-size: var(--t-md); font-weight: 300; }
  .side-card .checklist { margin: 14px 0 20px; }
  .side-card .checklist li + li { margin-top: 10px; }
  .side-card .btn { width: 100%; }
  .side-link { display: block; margin-top: 12px; font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); text-decoration: underline; }
  .side-contact { margin-top: 24px; font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); line-height: 1.5; }
  .side-h { font-weight: 700; }
  .side-contact a:hover { text-decoration: underline; }
  .side-rating { display: flex; align-items: center; gap: 11px; margin-top: 20px; font-family: var(--f-head); font-weight: 300; font-size: var(--t-xs); }
  .score { display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; border-radius: 50%; background: var(--c-light); box-shadow: var(--sh-btn); font-weight: 900; font-size: var(--t-md); }
  @media (max-width: 1100px) { .side { position: static; } }
</style>
