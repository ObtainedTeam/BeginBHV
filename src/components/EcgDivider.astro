---
// Hartslaglijn als ECG-monitor: één doorlopende lijn die van links naar rechts
// wordt "geschreven" door een sweep, één slag per doorloop. Het vorige spoor blijft
// zwak staan en wordt vlak voor de cursor gewist, zoals op een echte monitor.
// Vaste verhouding (viewBox 1386x100, gelijk aan de aangeleverde PNG).
const { class: cls = '' } = Astro.props;
const d = 'M0 50 H290 L302 29 L312 50 L320 6 L336 94 L352 29 L362 50 H1386';
const dur = '9s';
const uid = Math.random().toString(36).slice(2, 7);
---
<div class={`ecg ${cls}`} aria-hidden="true">
  <svg viewBox="0 0 1386 100" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- nieuw spoor: van links tot aan de cursor -->
      <clipPath id={`ecg-new-${uid}`}>
        <rect x="0" y="-10" width="0" height="120">
          <animate attributeName="width" from="0" to="1386" dur={dur} repeatCount="indefinite" />
        </rect>
      </clipPath>
      <!-- oud spoor: vanaf een stukje na de cursor tot rechts -->
      <clipPath id={`ecg-old-${uid}`}>
        <rect x="60" y="-10" width="1386" height="120">
          <animate attributeName="x" from="60" to="1446" dur={dur} repeatCount="indefinite" />
        </rect>
      </clipPath>
    </defs>
    <path class="ecg-trace old" d={d} clip-path={`url(#ecg-old-${uid})`} />
    <path class="ecg-trace new" d={d} clip-path={`url(#ecg-new-${uid})`} />
  </svg>
</div>
<style>
  .ecg { position: relative; width: 100%; height: 110px; overflow: hidden; }
  .ecg svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ecg-trace { stroke: #ff0000; stroke-width: 4.5; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .ecg-trace.new { filter: drop-shadow(0 0 3px rgba(255,0,0,.5)) drop-shadow(0 1.5px 1.5px rgba(0,0,0,.25)); }
  .ecg-trace.old { opacity: .28; }
  @media (prefers-reduced-motion: reduce) { .ecg-trace.old { display: none; } .ecg-trace.new { clip-path: none; } }
  @media (max-width: 700px) { .ecg { height: 70px; } }
</style>
