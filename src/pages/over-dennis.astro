---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContentLayout from '../components/ContentLayout.astro';
import Prose from '../components/Prose.astro';
// PLACEHOLDER-biografie. Vervang door de echte tekst van Dennis.
const sections = [
  { h: 'Van vastgoed, naar doet goed', p: ['Dennis Sluijmer werkte jarenlang in het vastgoed. Tijdens een BHV-inzet in een van zijn eigen panden zag hij hoeveel verschil een goed getrainde collega maakt: iemand die niet verstijft, maar handelt. Dat moment was de aanleiding om van BHV zijn vak te maken.', 'Sinds de oprichting van BeginBHV traint Dennis teams door heel Nederland: van kinderopvang tot bouwplaats, van kantoor tot zorginstelling. Praktisch, met realistische scenario’s en zonder onnodige theorie.'] },
  { h: 'Certificeringen en erkenningen', list: ['Gecertificeerd BHV-instructeur', 'Kiwa-gecertificeerd opleider', 'Aangesloten bij BVBN (Branchevereniging Bedrijfshulpverlening Nederland)', 'NIBHV-examinator (placeholder, bevestigen)'] },
  { h: 'Zijn aanpak', p: ['“Je hoeft geen held te zijn om levens te redden. Je moet alleen weten wat je moet doen, en dat oefenen we net zo lang tot het vanzelf gaat.” Elke cursusdag begint met de vraag: wat kan er bij jullie misgaan? Daar bouwt Dennis de scenario’s omheen, zodat je oefent met wat voor jouw werkvloer relevant is.'], note: 'Dennis geeft alle cursussen zelf of met een vast team van instructeurs die hij persoonlijk heeft opgeleid.' },
];
---
<Base title="Over Dennis" description="Maak kennis met Dennis Sluijmer, eigenaar en cursusleider van BeginBHV.">
  <PageHero title="Maak kennis met Dennis" intro="Eigenaar en cursusleider van BeginBHV." image="/images/kennismaken-foto.webp" imageAlt="Dennis Sluijmer" />
  <ContentLayout courseSlug="bhv-standaard" sideTitle="Een dag trainen met Dennis?" ctaTitle="Plan een cursus met Dennis en betaal achteraf">
    <Prose sections={sections} />
  </ContentLayout>
</Base>
