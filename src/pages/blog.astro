---
import Base from '../layouts/Base.astro';
---
<Base title="Blog" description="Nieuws, tips en achtergrond over bedrijfshulpverlening van BeginBHV.">
  <section class="pg">
    <div class="container pg-inner">
      <h1>Blog</h1>
      <p>Binnenkort lees je hier nieuws over BHV, wijzigingen in de Arbowet en praktische tips voor een veilige werkvloer.</p>
      <a class="btn btn-plan" href="/cursussen">Bekijk de cursussen</a>
    </div>
  </section>
</Base>
<style>
  .pg { background: linear-gradient(180deg, rgba(255,0,0,.07) 0%, rgba(0,0,0,0) 100%), #fff; }
  .pg-inner { padding-top: 120px; padding-bottom: 120px; max-width: 760px; }
  h1 { font-family: var(--f-head); font-weight: 800; font-size: var(--t-display); line-height: 1.2; }
  p { font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); line-height: 1.3; margin: 20px 0 30px; }
</style>
