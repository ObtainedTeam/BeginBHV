---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContentLayout from '../components/ContentLayout.astro';
import Prose from '../components/Prose.astro';
import { branches } from '../data/branches.js';
const sections = [
  { h: 'Zo werkt incompany', list: ['Vanaf 5 deelnemers, maximaal 12 per groep (grotere teams verdelen we over groepen)', 'Wij brengen alles mee: reanimatiepoppen, AED-trainer, blusmiddelen, lesmateriaal', 'Jullie regelen een ruimte van circa 40 m² en een plek buiten om te blussen', 'Eén dag, 09:00 tot 17:00, of in overleg twee halve dagen', 'Certificaten en pasjes binnen een week in huis'] },
  { h: 'Waarom op eigen locatie?', p: ['Je oefent de ontruiming via jullie echte vluchtroutes, met jullie blusmiddelen en op de plek waar het straks moet gebeuren. Dat blijft beter hangen dan een oefening in een cursuslokaal. Daarnaast scheelt het reistijd en kun je de training combineren met een teamdag of studiedag.'] },
  { h: 'Advies en BHV-plan', p: ['Op verzoek combineren we de training met een rondgang door het pand: waar hangen de blussers, klopt de verzamelplaats, is de AED bereikbaar? De bevindingen verwerken we in een kort advies of een compleet <a href="/kennisbank/bhv-plan">BHV-plan</a>.'] },
  { h: 'Tarieven', p: ['Incompany rekenen we per groep, niet per persoon, dus hoe voller de groep, hoe voordeliger. Vraag een offerte aan met het aantal deelnemers, de gewenste cursus en de locatie; je hebt binnen één werkdag een voorstel.'], note: 'Voorbeeldtarief: BHV Standaard incompany vanaf € 1.495 per groep tot 12 personen, inclusief materiaal, certificaten en reiskosten.' },
];
---
<Base title="Incompany BHV-training" description="BHV-training op jullie eigen locatie, overal in Nederland. Vanaf 5 deelnemers, wij nemen alle materialen mee. Vraag een offerte aan.">
  <PageHero title="Incompany BHV-training" intro="Wij komen naar jullie toe, overal in Nederland. Jullie team oefent op de eigen werkvloer, met de eigen vluchtroutes en blusmiddelen." image="/images/foto-trailer.webp" imageAlt="De mobiele trainingsaanhanger van BeginBHV met brandbak en blusmiddelen" />
  <ContentLayout courseSlug="bhv-standaard" sideTitle="Incompany aanvragen?" ctaTitle="Boek een incompany training en betaal achteraf">
    <Prose sections={sections}>
      <section class="more">
        <h2>Per branche</h2>
        <ul>{branches.map((o) => <li><a href={`/branches/${o.slug}`}>{o.short}</a></li>)}</ul>
      </section>
    </Prose>
  </ContentLayout>
</Base>
<style>
  .more { margin-top: 40px; padding-top: 24px; border-top: 1px solid rgba(0,0,0,.12); }
  .more h2 { font-family: var(--f-head); font-weight: 700; font-size: var(--t-lg); margin-bottom: 10px; }
  .more ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); }
  .more a { text-decoration: underline; }
</style>
