---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContentLayout from '../../components/ContentLayout.astro';
import Prose from '../../components/Prose.astro';
import { locaties } from '../../data/locaties.js';
import { courses } from '../../data/courses.js';
export function getStaticPaths() { return locaties.map((l) => ({ params: { slug: l.slug }, props: { l } })); }
const { l } = Astro.props;
const sections = [
  { h: 'Adres en bereikbaarheid', p: [`<strong>${l.name}</strong><br>${l.address}${l.postcode ? '<br>' + l.postcode + ' ' + l.city : ''}`, l.note] },
  { h: `Cursussen in ${l.city}`, p: [`Alle cursussen van BeginBHV worden op deze locatie gegeven. Kies een cursus en plan direct, of vraag een offerte aan voor je hele team.`], list: courses.map((c) => `${c.title} (vanaf € ${c.price})`) },
  { h: 'Wat je kunt verwachten', list: ['Kleine groepen, maximaal 12 deelnemers', 'Koffie, thee en lunch inbegrepen', 'Alle oefenmaterialen aanwezig: reanimatiepoppen, AED-trainer, blusmiddelen', 'Buitenruimte voor de blusoefening'] },
];
---
<Base title={`BHV cursus ${l.city}`} description={`Volg je BHV-cursus in ${l.city} bij ${l.name}. ${l.note}`} image={l.image}>
  <PageHero title={`BHV cursus in ${l.city}`} intro={`${l.name}. Regio ${l.region}.`} image={l.image} imageAlt={l.name} badge="Trainingslocatie" />
  <ContentLayout courseSlug="bhv-standaard" sideTitle={`Plannen in ${l.city}?`}>
    {l.placeholder && <p class="ph-note">Let op: adresgegevens en foto van deze locatie worden nog aangevuld.</p>}
    <Prose sections={sections}>
      <section class="more">
        <h2>Andere locaties</h2>
        <ul>{locaties.filter((x) => x.slug !== l.slug).map((o) => <li><a href={`/locaties/${o.slug}`}>{o.city}</a></li>)}<li><a href="/incompany">Bij jullie op locatie</a></li></ul>
      </section>
    </Prose>
  </ContentLayout>
</Base>
<style>
  .ph-note { font-family: var(--f-head); font-weight: 300; font-size: var(--t-sm); color: var(--c-red-dark); margin-bottom: 20px; }
  .more { margin-top: 40px; padding-top: 24px; border-top: 1px solid rgba(0,0,0,.12); }
  .more h2 { font-family: var(--f-head); font-weight: 700; font-size: var(--t-lg); margin-bottom: 10px; }
  .more ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); }
  .more a { text-decoration: underline; }
</style>
