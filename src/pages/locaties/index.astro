---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import National from '../../components/National.astro';
import UspBar from '../../components/UspBar.astro';
import { locaties } from '../../data/locaties.js';
---
<Base title="Trainingslocaties" description="BeginBHV traint bij u op locatie, overal in Nederland. Kleinere groep? Dan regelen we in overleg een externe trainingslocatie in de buurt.">
  <PageHero title="Waar we trainen" intro="Vanaf vijf deelnemers komen we naar jullie toe, overal in Nederland, met alle oefenmaterialen. Voor kleinere groepen of losse deelnemers regelen we in overleg een externe trainingslocatie bij jullie in de buurt." />
  <section class="lc">
    <div class="container">
      <div class="lc-grid">
        {locaties.map((l, i) => (
          <a class="lc-card reveal" href={`/locaties/${l.slug}`} style={`transition-delay:${(i % 3) * 80}ms`}>
            <img src={l.image} alt="" width="378" height="220" loading="lazy" />
            <div class="lc-body">
              <h2>{l.city}</h2>
              <p class="lc-name">{l.name}</p>
              <p>{l.note}</p>
              <span class="lc-more">Bekijk locatie ›</span>
            </div>
          </a>
        ))}
        <a class="lc-card lc-incompany reveal" href="/incompany">
          <div class="lc-body">
            <h2>Bij jullie op locatie</h2>
            <p>Vanaf vijf deelnemers komen we naar jullie bedrijf, met alle materialen. Oefen op de plek waar het straks moet gebeuren, met jullie eigen vluchtroutes.</p>
            <span class="lc-more">Incompany-training ›</span>
          </div>
        </a>
        <a class="lc-card lc-incompany reveal" href="/contact">
          <div class="lc-body">
            <h2>Externe locatie in overleg</h2>
            <p>Kleinere groep of een losse deelnemer? Dan regelen we een trainingsruimte bij jullie in de buurt. Vraag het aan via het contactformulier, dan stemmen we datum en plek af.</p>
            <span class="lc-more">Aanvragen ›</span>
          </div>
        </a>
      </div>
    </div>
  </section>
  <National />
  <UspBar />
</Base>
<style>
  .lc { background: linear-gradient(180deg, rgba(255,0,0,.06) 0%, rgba(0,0,0,0) 100%), #fff; padding: 60px 0 40px; }
  .lc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36px; }
  .lc-card { display: block; background: var(--c-light); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--sh-card); transition: transform .25s, box-shadow .25s; }
  .lc-card:hover { transform: translateY(-4px); box-shadow: var(--sh-card-strong); }
  .lc-card img { width: 100%; height: 220px; object-fit: cover; }
  .lc-body { padding: 20px 22px 24px; }
  .lc-body h2 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h5); line-height: 1.25; }
  .lc-name { font-family: var(--f-head); font-weight: 700; font-size: var(--t-md); margin-top: 4px; }
  .lc-body p { font-family: var(--f-head); font-weight: 300; font-size: var(--t-sm); line-height: 1.35; margin-top: 8px; }
  .lc-more { display: inline-block; margin-top: 14px; font-family: var(--f-head); font-weight: 700; font-size: var(--t-md); color: var(--c-red-dark); }
  .lc-incompany { background: var(--c-coral); color: #fff; display: flex; align-items: center; }
  .lc-incompany .lc-more { color: #fff; }
  @media (max-width: 760px) { .lc-grid { grid-template-columns: 1fr; } }
</style>
