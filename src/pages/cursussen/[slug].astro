---
import Base from '../../layouts/Base.astro';
import CourseHero from '../../components/CourseHero.astro';
import CourseDetails from '../../components/CourseDetails.astro';
import Praktijkdag from '../../components/Praktijkdag.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqRows from '../../components/FaqRows.astro';
import { courses } from '../../data/courses.js';

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course } = Astro.props;
const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${course.title} Cursus`,
  description: course.blurb,
  url: new URL(`/cursussen/${course.slug}`, Astro.site).href,
  image: new URL(course.image, Astro.site).href,
  provider: { '@type': 'Organization', name: 'BeginBHV', url: Astro.site.href },
  offers: { '@type': 'Offer', price: course.price.replace(',', '.'), priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: new URL(`/contact?cursus=${course.slug}`, Astro.site).href },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'Onsite', courseWorkload: 'P1D', location: { '@type': 'Place', name: 'Op locatie van de klant of externe trainingslocatie', address: { '@type': 'PostalAddress', addressCountry: 'NL' } } },
};
---
<Base title={`${course.title} Cursus`} description={`${course.title}: ${course.blurb} Eendaagse praktijktraining met erkend certificaat, door heel Nederland.`} image={course.image}>
  <script type="application/ld+json" set:html={JSON.stringify(courseLd)} />
  <CourseHero course={course} heading="h1" textTop={58} />
  <CourseDetails course={course} />
  <Praktijkdag course={course} />
  <CtaBand title={`Boek nu de ${course.title} cursus en betaal achteraf`} />
  <FaqRows />
</Base>
