---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import UspBar from '../components/UspBar.astro';
import CtaBand from '../components/CtaBand.astro';
const price = '29,99';
---
<Base title="Cursusboek Werk ook compleet veilig" description="Het BeginBHV cursusboek 'Werk ook compleet veilig': de ideale aanvulling op je BHV-cursus. Bestel voor € 29,99 incl. btw.">
  <PageHero title="Cursusboek: Werk ook compleet veilig" intro="De ideale aanvulling op je BHV-cursus. Veiligheidsopleidingen, keuringen van AED's en brandblussers, EHBO-artikelen en advies voor risicopreventie, in één boek." badge="Beoordeeld met 8,8" />
  <section class="cb">
    <div class="container cb-inner">
      <div class="cb-visual reveal">
        <img class="cb-cover" src="/images/boek-cover.webp" alt="" width="393" height="295" />
        <img class="cb-open" src="/images/boek-open.webp" alt="Opengeslagen cursusboek" width="541" height="378" />
      </div>
      <div class="cb-buy">
        <h2>BHV én meer!</h2>
        <ul class="checklist">
          <li>Alle cursusstof van BHV Basis en Standaard</li>
          <li>Ongevalpreventie, veilige werkplekken en ARBO-regels</li>
          <li>Keuringen van AED's en blusmiddelen uitgelegd</li>
          <li>Praktische checklists voor je eigen bedrijf</li>
        </ul>
        <p class="cb-price"><strong>€ {price}</strong> incl. btw, exclusief verzending</p>
        <form class="cb-form" method="post" action="/api/aanvraag" data-form>
          <input type="hidden" name="source" value="cursusboek" />
          <input type="hidden" name="product" value="Cursusboek Werk ook compleet veilig" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <label><span>Aantal</span><input type="number" name="quantity" value="1" min="1" max="50" required /></label>
          <label><span>Naam</span><input type="text" name="name" required autocomplete="name" /></label>
          <label><span>E-mailadres</span><input type="email" name="email" required autocomplete="email" /></label>
          <label><span>Bezorgadres</span><input type="text" name="address" required autocomplete="street-address" /></label>
          <label><span>Postcode en plaats</span><input type="text" name="city" required /></label>
          <button class="cart" type="submit">Bestel het cursusboek</button>
          <p class="cb-note">Je ontvangt een bevestiging per e-mail; betalen kan via iDEAL-link of op factuur.</p>
          <p class="status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
  <CtaBand />
  <UspBar />
</Base>
<style>
  .cb { background: linear-gradient(180deg, rgba(255,0,0,.06) 0%, rgba(0,0,0,0) 100%), #fff; }
  .cb-inner { display: grid; grid-template-columns: 1fr 480px; gap: 60px; padding-top: 60px; padding-bottom: 70px; align-items: start; }
  .cb-visual { position: relative; min-height: 420px; }
  .cb-open { position: absolute; left: 0; top: 0; width: 541px; max-width: 100%; }
  .cb-cover { position: absolute; left: 60%; top: 40px; width: 300px; max-width: 45%; }
  .cb-buy { background: var(--c-light); border-radius: var(--r-lg); box-shadow: var(--sh-card); padding: 28px 28px 24px; }
  .cb-buy h2 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h5); }
  .cb-buy .checklist { margin: 14px 0 18px; }
  .cb-buy .checklist li + li { margin-top: 10px; }
  .cb-price { font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); margin-bottom: 18px; }
  .cb-price strong { font-weight: 800; font-size: var(--t-h3); }
  .hp { position: absolute; left: -9999px; }
  .cb-form label { display: block; margin-bottom: 10px; }
  .cb-form span { display: block; font-family: var(--f-body); font-weight: 200; font-size: var(--t-sm); margin-bottom: 2px; }
  .cb-form input { width: 100%; height: 30px; border: 0; border-radius: 5px; background: #fff; box-shadow: var(--sh-input); padding: 0 9px; font-family: var(--f-body); font-weight: 200; font-size: var(--t-md); }
  .cart { display: block; width: 100%; height: 47px; margin-top: 16px; border: 0; border-radius: 4.3px; background: var(--c-green-dark); color: #fff; font-family: var(--f-head); font-weight: 300; font-size: var(--t-md); }
  .cart:hover { filter: brightness(1.08); }
  .cb-note { font-family: var(--f-head); font-weight: 300; font-size: var(--t-xs); margin-top: 10px; }
  .status { font-family: var(--f-head); font-weight: 300; font-size: 14px; min-height: 1em; margin-top: 8px; }
  .status.err { color: var(--c-red-dark); }
  @media (max-width: 1000px) { .cb-inner { grid-template-columns: 1fr; } .cb-visual { min-height: 0; display: flex; justify-content: center; } .cb-open { position: static; } .cb-cover { display: none; } }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-form]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('.status')!; const btn = form.querySelector<HTMLButtonElement>('button')!;
    btn.disabled = true; status.className = 'status'; status.textContent = 'Versturen…';
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      if (!res.ok) throw new Error();
      location.href = '/bedankt';
    } catch { status.className = 'status err'; status.textContent = 'Versturen is niet gelukt. Mail naar info@beginbhv.nl.'; btn.disabled = false; }
  });
</script>
