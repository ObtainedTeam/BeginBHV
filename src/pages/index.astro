---
// Homepage volgens Figma-frames BHV1, BHV2, BHV3, BHV4, Page, BHV5, Training details, Footer.
import Base from '../layouts/Base.astro';
import DirectAanmelden from '../components/DirectAanmelden.astro';
import EcgDivider from '../components/EcgDivider.astro';
import Faq from '../components/Faq.astro';
import ContactCard from '../components/ContactCard.astro';
import National from '../components/National.astro';
import Funnel from '../components/Funnel.astro';
import CourseHero from '../components/CourseHero.astro';
import CourseDetails from '../components/CourseDetails.astro';
import { getCourse } from '../data/courses.js';
import { clientReview, studentReviews, faq, homeInfoCards, funnelSectionTitle } from '../data/content.js';

const featured = ['bhv-basis', 'bhv-nibhv', 'bhv-herhaling'].map((s) => getCourse(s));
const packageLines = {
  'bhv-basis': ['E-learning vooraf, in eigen tempo', 'Eerste hulp en reanimatie met AED', 'Beginnende brand blussen', 'Ontruiming begeleiden', 'Erkend certificaat, één jaar geldig'],
  'bhv-nibhv': ['Alles van Basis BHV', 'Officieel NIBHV examen', 'Landelijk erkend diploma', 'Registratie in NIBHV-register', 'Diploma en pasje inbegrepen'],
  'bhv-herhaling': ['E-learning: theorie opfrissen', 'Reanimatie en AED oefenen', 'Brand en ontruiming', 'Certificaat één jaar verlengd', 'Nieuw BHV-pasje inbegrepen'],
};
const ploegleider = getCourse('bhv-basis');
---
<Base title="BeginBHV | Erkende BHV-trainingen door heel Nederland">
  <!-- BHV1: hero -->
  <section class="hero">
    <video class="hero-bg" autoplay muted loop playsinline preload="metadata" poster="/images/hero-poster.webp" aria-hidden="true" data-hero-video>
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-stage">
      <h1 class="hero-logo">
        <img src="/images/logo-wordmark-white.png" alt="BeginBHV" width="1600" height="339" />
        <span class="sr-only">BeginBHV, erkende BHV-trainingen door heel Nederland</span>
      </h1>
      <div class="hero-cta"><DirectAanmelden /></div>
    </div>
  </section>

  <!-- BHV2: pakketten -->
  <section class="packages" aria-labelledby="pk-title">
    <div class="pk-band"></div>
    <h2 id="pk-title" class="sr-only">Onze BHV-cursussen</h2>
    <div class="pk-stage">
      {featured.map((c, i) => (
        <article class={`pk reveal`} style={`transition-delay:${i * 90}ms`}>
          <div class="pk-circle"><img src={c.icon} alt="" width="130" height="130" loading="lazy" /></div>
          <div class="pk-card">
            <h3>{c.title}</h3>
            <ul>
              {packageLines[c.slug].map((l) => <li>{l}</li>)}
            </ul>
          </div>
          <a class="btn btn-primary pk-btn" href={`/cursussen/${c.slug}`}>Plan direct</a>
        </article>
      ))}
    </div>
  </section>

  <!-- BHV3: funnel + Maak kennis met Dennis -->
  <section class="funnel-sec">
    <div class="container">
      <h2 class="fs-title">{funnelSectionTitle}</h2>
      <div class="fs-grid">
      <div class="reveal from-left"><Funnel /></div>
      <div class="kennis reveal from-right">
        <div class="kennis-photo">
          <img src="/images/kennismaken-foto.webp" alt="Dennis, oprichter van BeginBHV" width="389" height="428" loading="lazy" />
        </div>
        <div class="kennis-text">
          <h2>Maak kennis met Dennis!</h2>
          <p class="tagline">Van vastgoed, naar doet goed.</p>
          <blockquote>
            <p>“Na jaren in het vastgoed wilde ik iets doen dat er écht toe doet. Tijdens een BHV-inzet op een van mijn eigen panden zag ik hoeveel verschil een goed getrainde collega maakt. Sindsdien train ik teams door heel Nederland: praktisch, met realistische scenario’s en zonder onnodige theorie. Mijn doel is simpel: dat iedereen die bij mij een dag heeft gezeten, durft te handelen als het erop aankomt.”</p>
          </blockquote>
          <p class="attribution">Dennis, oprichter en cursusleider</p>
        </div>
      </div>
      </div>
    </div>
    <EcgDivider class="fs-ecg" />
  </section>

  <!-- BHV4: reviews -->
  <section class="reviews" aria-labelledby="rv-title">
    <div class="container rv-inner">
      <div class="rv-client">
        <h2 id="rv-title">Wat klanten zeggen over BeginBHV</h2>
        <p class="rv-name">{clientReview.name}</p>
        <blockquote><p>{clientReview.quote}</p></blockquote>
        <img class="rv-logo" src={clientReview.logo} alt="" width="121" height="113" loading="lazy" />
      </div>
      <div class="rv-card reveal" data-carousel>
        <h2>Wat onze cursisten zeggen</h2>
        {studentReviews.map((r, i) => (
          <div class="rv-slide" data-slide hidden={i !== 0}>
            <p class="rv-name">{r.name}</p>
            <blockquote><p>{r.quote}</p></blockquote>
            {r.logo && <img class="rv-slide-logo" src={r.logo} alt="" width="146" height="77" loading="lazy" />}
          </div>
        ))}
        <div class="rv-dots" role="tablist" aria-label="Reviews">
          {studentReviews.map((_, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Review ${i + 1}`} data-dot={i}></button>
          ))}
        </div>
      </div>
    </div>
    <div class="rv-band"></div>
  </section>

  <!-- Page: landelijk actief + FAQ + contact -->
  <National />

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title">Veel gestelde vragen</h2>
      {homeInfoCards.map((c, i) => (
        <div class={`info-row ${i % 2 === 1 ? 'rev' : ''}`}>
          <img class={`info-photo reveal ${i % 2 === 1 ? "from-right" : "from-left"}`} src={c.image} alt={c.alt} width="629" height="410" loading="lazy" />
          <article class={`info-card reveal ${i % 2 === 1 ? "from-left" : "from-right"}`}>
            <h3>{c.title}</h3>
            <p set:html={c.html} />
            <a class="btn btn-small" href={c.href}>Lees meer</a>
          </article>
        </div>
      ))}
      <div class="faq-row">
        <div class="faq-contact">
          <ContactCard variant="narrow" title="Contact" source="home-contact" />
        </div>
        <div class="faq-list">
          <Faq items={faq.slice(0, 4)} variant="cards" openFirst={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- BHV5 + Training details: uitgelichte cursus -->
  <CourseHero course={ploegleider} />
  <CourseDetails course={ploegleider} />
</Base>

<style>
  /* ---------- BHV1 hero (1386 x 522) ---------- */
  .hero { position: relative; height: 522px; background: #000; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .34; }
  /* donkere laag over de video */
  .hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.15) 50%, rgba(0,0,0,.45) 100%); z-index: 1; pointer-events: none; }
  .hero-stage { position: relative; width: var(--w-page); max-width: 100%; height: 100%; margin-inline: auto; z-index: 2; }
  .hero-logo { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 560px; margin: 0; filter: drop-shadow(0 2px 6px rgba(0,0,0,.45)); }
  .hero-logo img { width: 100%; height: auto; }
  .hero-cta { position: absolute; left: 1132px; top: 77.7px; }

  /* ---------- BHV2 pakketten (1386 x 552) ---------- */
  .packages { position: relative; height: 600px; background: var(--c-white); }
  .pk-band { position: absolute; left: 0; right: 0; top: -1.3px; height: 43.3px; background: var(--c-red-dark); }
  .pk-stage { position: relative; width: var(--w-page); max-width: 100%; height: 100%; margin-inline: auto; }
  .pk { position: absolute; top: 21.7px; width: 316px; padding-top: 62px; }
  .pk:nth-child(1) { left: 153px; } .pk:nth-child(2) { left: 535px; } .pk:nth-child(3) { left: 917px; }
  .pk-circle { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 124px; height: 124px; border-radius: 50%; background: var(--c-white); z-index: 1; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 16px -6px rgba(0,0,0,.25); }
  .pk-circle img { width: 84px; height: 84px; object-fit: contain; }
  .pk-card { height: 404px; background: var(--c-light); border-radius: 14px; box-shadow: var(--sh-card-strong); padding: 78px 26px 0 28px; }
  .pk-card h3 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h5); line-height: 1.6; }
  .pk-card ul { list-style: none; margin: 11px 0 0 0; padding: 0; font-family: var(--f-body); font-weight: 100; font-size: var(--t-md); line-height: 1.17; }
  .pk-card li { position: relative; padding-left: 18px; min-height: 17.6px; }
  .pk-card li + li { margin-top: 15px; }
  .pk-card li { padding-left: 26px; }
  .pk-card li::before { content: ''; position: absolute; left: 0; top: 1px; width: 17.6px; height: 17.4px; background: url('/images/icon-check.png') center / contain no-repeat; }
  .pk-btn { position: absolute; left: 50%; transform: translateX(-50%); bottom: -23px; }

  /* ---------- BHV3 funnel + kennismaken (1386 x 1481) ---------- */
  .funnel-sec { position: relative; background: linear-gradient(180deg, rgba(255,0,0,.1) 0%, rgba(0,0,0,0) 100%), #fff; padding-top: 75px; padding-bottom: 106px; }
  .fs-title { font-family: var(--f-head); font-weight: 800; font-size: var(--t-display); color: var(--c-red-dark); text-align: center; text-shadow: var(--sh-text); line-height: 1.25; margin-bottom: 34px; }
  .fs-grid { display: grid; grid-template-columns: 640px 1fr; gap: 56px; align-items: start; max-width: 1240px; margin-inline: auto; }
  .fs-grid :global(.funnel) { width: 100%; }
  .kennis { display: grid; grid-template-columns: 1fr; gap: 26px; }
  .kennis-photo { width: 100%; height: 300px; border-radius: 22px; overflow: hidden; box-shadow: var(--sh-card-strong); }
  .kennis-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 15%; }
  .kennis-text { margin-top: 0; }
  .kennis-text h2 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h3); line-height: 1.2; }
  .tagline { font-family: var(--f-head); font-weight: 400; font-size: var(--t-h5); line-height: 1.15; margin-top: 8px; color: var(--c-red-dark); }
  .kennis-text blockquote { margin: 18px 0 0; max-width: 520px; }
  blockquote p { font-family: var(--f-body); font-weight: 200; font-style: italic; font-size: var(--t-md); line-height: 1.5; }
  .attribution { font-family: var(--f-body); font-weight: 100; font-style: italic; font-size: var(--t-md); margin: 8px 0 0 5px; }
  :global(.fs-ecg) { margin-top: 34px; }

  /* ---------- BHV4 reviews (1386 x 612) ---------- */
  .reviews { background: var(--c-white); }
  .rv-inner { display: grid; grid-template-columns: 1fr 491px; gap: 96px; padding-top: 54px; padding-bottom: 60px; padding-left: max(var(--gutter), 157px); padding-right: max(var(--gutter), 157px); min-height: 498px; }
  @media (min-width: 1420px) { .rv-inner { padding-left: 157px; padding-right: 157px; } }
  .rv-client { position: relative; }
  .rv-client h2 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h2); line-height: 1.25; max-width: 460px; }
  .rv-client .rv-name { font-family: var(--f-head); font-weight: 700; font-size: var(--t-lg); margin: 15px 0 0; line-height: 1.6; }
  .rv-client blockquote { margin: 0; max-width: 440px; }
  .rv-client blockquote p { line-height: 1.7; }
  .rv-logo { position: static; margin-top: 18px; width: 110px; height: auto; }
  .rv-card { position: relative; min-height: 317px; background: var(--c-coral); color: var(--c-white); border-radius: var(--r-md); box-shadow: var(--sh-card-strong); padding: 18px 14px 40px; margin-top: -4px; }
  .rv-card h2 { font-family: var(--f-head); font-weight: 900; font-size: var(--t-h3); line-height: 1.25; }
  .rv-card .rv-name { font-family: var(--f-head); font-weight: 700; font-size: var(--t-lg); margin: 4px 0 0 9px; }
  .rv-card blockquote { margin: 6px 0 0 38px; max-width: 397px; }
  .rv-slide-logo { position: absolute; right: 35px; top: 176px; width: 146px; height: auto; }
  .rv-dots { position: absolute; right: 14px; bottom: 13px; display: flex; gap: 6px; }
  .rv-dots button { width: 58.3px; height: 7.7px; border-radius: 5px; border: 0; background: var(--c-light); opacity: .7; padding: 0; }
  .rv-dots button[aria-selected='true'] { background: var(--c-white); opacity: 1; }
  .rv-slide { animation: fade .4s ease; }
  @keyframes fade { from { opacity: 0; } }
  .rv-band { height: 114px; background: var(--c-light); }

  /* ---------- Page: FAQ ---------- */
  .faq-section { background: linear-gradient(180deg, rgba(255,0,0,.04) 0%, rgba(255,0,0,.07) 100%), #fff; padding: 20px 0 126px; }
  .faq-section h2 { font-family: var(--f-head); font-weight: 800; font-size: var(--t-display); text-align: center; line-height: 1.55; margin-bottom: 40px; }
  .info-row { display: grid; grid-template-columns: 629px 466px; justify-content: center; gap: 28.7px; margin-bottom: 35px; }
  .info-row.rev { grid-template-columns: 466px 637px; gap: 20px; }
  .info-row.rev .info-card { order: -1; }
  .info-photo { width: 100%; height: 410px; object-fit: cover; border-radius: var(--r-md); }
  .info-card { position: relative; height: 410px; background: var(--c-white); border-radius: var(--r-md); box-shadow: var(--sh-card-strong); padding: 31px 35px 0 29px; }
  .info-card h3 { font-family: var(--f-head); font-weight: 700; font-size: var(--t-h2); color: var(--c-red); line-height: 1.25; }
  .info-card p { font-family: var(--f-body); font-weight: 100; font-size: var(--t-lg); line-height: 1.2; margin-top: 24px; max-width: 392px; }
  .info-card p :global(a) { text-decoration: underline; }
  .info-card .btn { position: absolute; left: 29px; bottom: 25px; }
  .faq-row { display: grid; grid-template-columns: 480px 640px; justify-content: center; gap: 44px; margin-top: 56px; align-items: start; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .hero { height: auto; padding: 90px 0 0; }
    .hero-stage { display: flex; flex-direction: column; align-items: center; padding: 0 var(--gutter) 60px; }
    .hero-logo, .hero-cta { position: static; transform: none; }
    .hero-logo { width: 300px; order: 1; margin: 30px 0 20px; }
    .hero-cta { order: 4; margin: 24px 0 0; }
    .packages { height: auto; padding-bottom: 60px; }
    .pk-stage { display: flex; flex-wrap: wrap; justify-content: center; gap: 60px 24px; padding: 0 var(--gutter); }
    .pk, .pk:nth-child(1), .pk:nth-child(2), .pk:nth-child(3) { position: relative; left: auto; top: 21.7px; }
    .fs-grid { grid-template-columns: 1fr; }
    .kennis-photo { height: 260px; }
    :global(.fs-ecg) { margin-top: 20px; }
    .rv-inner { grid-template-columns: 1fr; padding-inline: var(--gutter); }
    .rv-logo { position: static; margin: 16px 0 0; }
    .info-row, .info-row.rev { grid-template-columns: 1fr; }
    .info-row.rev .info-card { order: 2; }
    .info-photo { height: auto; }
    .faq-row { grid-template-columns: 1fr; }
    .faq-contact { display: flex; justify-content: center; min-width: 0; }
  }
  @media (max-width: 700px) {
    .hero-logo { width: 240px; }
    .fs-title, .kennis-text h2, .faq-section h2 { font-size: 30px; }
    .tagline { font-size: 30px; }
    .rv-client h2, .rv-card h2 { font-size: 26px; }
    .rv-card { padding-bottom: 48px; }
    .rv-slide-logo { position: static; margin: 16px 0 0 38px; width: 110px; }
    .rv-card blockquote, .rv-card .rv-name { margin-left: 0; }
    .info-card { height: auto; padding-bottom: 80px; }
    .info-card h3 { font-size: 26px; }
    .faq-section { padding-bottom: 80px; }
    .pk-card { height: auto; padding-bottom: 50px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((car) => {
    const slides = [...car.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...car.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let i = 0, timer: number | undefined;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => (s.hidden = k !== i));
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
    };
    const start = () => { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => show(i + 1), 6000); };
    dots.forEach((d, k) => d.addEventListener('click', () => { show(k); clearInterval(timer); start(); }));
    start();
  });
</script>

<script>
  // Kleinere video op telefoon; geen video bij "verminderde beweging".
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
    else if (matchMedia('(max-width: 760px)').matches) { v.innerHTML = '<source src="/video/hero-mobile.webm" type="video/webm"><source src="/video/hero-mobile.mp4" type="video/mp4">'; v.load(); v.play().catch(() => {}); }
  }
</script>
